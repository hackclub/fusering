---
import eligibleIcon from "../assets/eligible_icon.png";
import originalIcon from "../assets/original_icon.png";
import printableIcon from "../assets/printable_icon.png";
import effortIcon from "../assets/effort_icon.png";

interface Props {
  icon: "eligible" | "original" | "printable" | "effort";
  title: string;
  text: string;
  dimensions?: { l: string; w: string; d: string };
  class?: string;
}

const { icon, title, text, dimensions, class: className = "" } = Astro.props;

const icons = {
  eligible: { src: eligibleIcon, bg: "bg-icon-blue" },
  original: { src: originalIcon, bg: "bg-icon-orange" },
  printable: { src: printableIcon, bg: "bg-icon-pink" },
  effort: { src: effortIcon, bg: "bg-icon-green" },
};

const { src: iconSrc, bg: iconBg } = icons[icon];
---

<div
  class={`bg-white border-4 border-black/35 rounded-3xl shadow-card p-6 flex flex-col gap-4 w-sm h-fit min-h-72 ${className}`}
>
  <div class={`${iconBg} rounded-xl w-12 h-12`}>
    <img src={iconSrc.src} class="w-full h-full" />
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="text-2xl font-baloo-2 font-bold">{title}</h3>
    <p class="text-base font-jakarta-sans min-h-[3lh]" set:html={text} />
  </div>
  {
    dimensions && (
      <p class="font-space-mono text-sm">
        <b>L:</b> {dimensions.l} | <b>W:</b> {dimensions.w} | <b>D:</b>{" "}
        {dimensions.d}
      </p>
    )
  }
</div>
