---
interface Props {
  bg?: "white" | "card-beige";
  class?: string;
}

const { bg = "white", class: className = "" } = Astro.props;

const bgClass = bg === "card-beige" ? "bg-card-beige" : "bg-white";
---

<div
  class={`${bgClass} border-4 border-black/35 rounded-3xl shadow-card p-6 sm:p-8 w-fit max-w-full h-fit flex flex-col gap-8 ${className}`}
>
  <slot />
</div>
