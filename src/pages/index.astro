---
import "../styles/global.css";

// images

import hero_banner from "../assets/hero_banner.png";
import logo from "../assets/logo.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body class="bg-card-beige text-text-black font-jakarta-sans">
    <!-- Hero banner -->
    <div class="h-fit bg-blue relative">
      <img src={hero_banner.src} class="top-0 left-0 w-full h-auto relative" />
      <div class="absolute z-10 inset-0 top-0 right-0 flex items-center m-16">
        <img src={logo.src} class="" />
      </div>
    </div>

    <!--Main -->
    <main class="min-h-screen flex flex-col gap-6 p-16"></main>
  </body>
</html>
