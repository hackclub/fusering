---
import "../styles/global.css";

// Components
import PillOne from "../components/pill_one.astro";
import Card from "../components/card.astro";
import CardTwo from "../components/card_two.astro";

// Images
import hero_banner from "../assets/hero_banner.png";
import logo from "../assets/logo.png";
import sticker_arrow_cluster from "../assets/sticker_arrow_cluster.png";

import step1_icon from "../assets/step1_icon.png";
import step2_icon from "../assets/step2_icon.png";
import step3_icon from "../assets/step3_icon.png";

import step1_image from "../assets/step1_image.png";
import step2_image from "../assets/step2_image.png";
import step3_image from "../assets/step3_image.png";

import info_icon from "../assets/info_icon.png";

import video_arrow from "../assets/video_arrow.png";
import video_placeholder from "../assets/video_placeholder.png";

import fusering_cad_model from "../assets/fusering_cad_model.png";
import project_image_1 from "../assets/project_image_1.png";
import project_image_2 from "../assets/project_image_2.png";
import project_image_3 from "../assets/project_image_3.png";
import project_image_4 from "../assets/project_image_4.png";
import project_image_5 from "../assets/project_image_5.png";

import fusering_logo_colour_small from "../assets/fusering_logo_colour_small.png";
import fusering_projects_cluster from "../assets/fusering_projects_cluster.png";

import fusering_sample_cluster from "../assets/fusering_sample_cluster.png";
import print_farm_image_cluster from "../assets/print_farm_image_cluster.png";

import fusering_logo_footer from "../assets/fusering_logo_footer.png";
import hc_logo_footer from "../assets/hc_logo_footer.png";
import cube_cluster_footer from "../assets/cube_cluster_footer.png";

import clubs_portal_screenshot from "../assets/clubs_portal_screenshot.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>
      Fusering - Design a keyring, we'll ship it to you with stickers!
    </title>
  </head>
  <body class="bg-card-beige text-text-black font-jakarta-sans">
    <!--Main -->
    <main class="flex flex-col gap-6 w-full max-w-[2100px] mx-auto">
      <!-- Section 1: hero -->
      <section class="min-h-[clamp(20rem,40vw,59.1875rem)] flex flex-col">
        <!-- Hero banner -->
        <div class="h-fit bg-blue relative">
          <img
            src={hero_banner.src}
            alt=""
            class="top-0 left-0 w-full h-auto relative"
          />
          <div
            class="absolute z-10 inset-0 top-0 right-0 flex items-center m-[clamp(1rem,4vw,4rem)]"
          >
            <img
              src={logo.src}
              alt="Fusering logo"
              class="max-w-[30%] h-auto"
            />
          </div>
        </div>

        <div
          class="flex flex-col gap-6 p-[clamp(1.5rem,4vw,4rem)] font-baloo-2 font-bold text-[clamp(1.75rem,3.5vw,3rem)] grow"
        >
          <h1>Design a keyring, we'll ship it to you with stickers!</h1>
          <div
            class="flex flex-row flex-wrap justify-between items-center gap-8 grow"
          >
            <div class="flex flex-col gap-8">
              <div class="flex flex-row flex-wrap gap-8">
                <PillOne
                  type="guide"
                  label="Read the guide"
                  modalId="guide_info_modal"
                />
                <PillOne
                  type="clubs"
                  label="Info for clubs"
                  modalId="clubs_info_modal"
                />
              </div>
              <div class="flex flex-row flex-wrap gap-8">
                <PillOne
                  type="submit"
                  label="Submit your design"
                  path="https://submit.hackclub.com/fusering-v2"
                />
              </div>
            </div>
            <img
              src={sticker_arrow_cluster.src}
              alt=""
              class="max-w-full h-auto ml-auto"
            />
          </div>
        </div>
      </section>

      <!-- Section 2: steps -->
      <section
        class="min-h-[clamp(20rem,40vw,59.1875rem)] flex flex-col gap-8 p-[clamp(1.5rem,4vw,4rem)] justify-center items-center"
      >
        <div
          class="flex flex-row flex-wrap gap-8 p-[clamp(1rem,3vw,4rem)] justify-center"
        >
          <!-- step 1 -->
          <div class="flex flex-row items-start gap-8">
            <img
              src={step1_icon.src}
              alt=""
              class="shrink-0 max-w-full h-auto"
            />
            <div
              class="flex flex-col gap-8 w-[clamp(13rem,30.7vw-10.3rem,26rem)]"
            >
              <div class="flex flex-col gap-2">
                <h2 class="text-4xl font-baloo-2 font-bold">
                  Prep your artwork.
                </h2>
                <p
                  class="text-xl font-jakarta-sans font-normal leading-relaxed min-h-[3lh]"
                >
                  Time to get creative! Create a unique design for the front of
                  your keyring, and turn it into a vector image.
                </p>
              </div>

              <img
                src={step1_image.src}
                alt="Example keyring artwork vector design"
                class="self-center max-w-full h-auto"
              />
            </div>
          </div>

          <!-- step 2 -->
          <div class="flex flex-row items-start gap-8">
            <img
              src={step2_icon.src}
              alt=""
              class="shrink-0 max-w-full h-auto"
            />
            <div
              class="flex flex-col gap-8 w-[clamp(13rem,30.7vw-10.3rem,26rem)]"
            >
              <div class="flex flex-col gap-2">
                <h2 class="text-4xl font-baloo-2 font-bold">
                  Make your keyring
                </h2>
                <p
                  class="text-xl font-jakarta-sans font-normal leading-relaxed min-h-[3lh]"
                >
                  Use the power of onshape, a popular CAD tool, to turn your
                  artwork into a real, 3D printable part.
                </p>
              </div>

              <img
                src={step2_image.src}
                alt="Example keyring CAD model in Onshape"
                class="self-center max-w-full h-auto"
              />
            </div>
          </div>

          <!-- step 3 -->
          <div class="flex flex-row items-start gap-8">
            <img
              src={step3_icon.src}
              alt=""
              class="shrink-0 max-w-full h-auto"
            />
            <div
              class="flex flex-col gap-8 w-[clamp(13rem,30.7vw-10.3rem,26rem)]"
            >
              <div class="flex flex-col gap-2">
                <h2 class="text-4xl font-baloo-2 font-bold">Show us!</h2>
                <p
                  class="text-xl font-jakarta-sans font-normal leading-relaxed min-h-[3lh]"
                >
                  Upload to printables.com and share your design with us! We'll
                  print off your design and throw in a carabiner and exclusive
                  stickers!
                </p>
              </div>

              <img
                src={step3_image.src}
                alt="Finished printed keyring with carabiner and stickers"
                class="self-center max-w-full h-auto"
              />
            </div>
          </div>
        </div>
        <!--Unsure where to start -->
        <div
          class="flex flex-row flex-wrap items-center gap-[clamp(1.5rem,4vw,4rem)] justify-center"
        >
          <Card>
            <div class="flex flex-col gap-8 w-[clamp(18rem,35vw-10rem,32rem)]">
              <div class="flex flex-row items-center gap-4">
                <img src={info_icon.src} alt="" class="max-w-full h-auto" />
                <h2 class="text-4xl font-baloo-2 font-bold">
                  Unsure where to start?
                </h2>
              </div>
              <p class="text-xl font-jakarta-sans leading-relaxed">
                We have a variety of resources to help you learn Figma and
                onshape, including written step-by-step tutorials,
                presentations, and videos
              </p>
            </div>
          </Card>
          <img src={video_arrow.src} alt="" class="hidden lg:block" />
          <button
            type="button"
            onclick="video_coming_soon_modal.showModal()"
            class="cursor-pointer"
          >
            <img
              src={video_placeholder.src}
              alt="Video placeholder for step-by-step tutorial"
              class="max-w-full h-auto"
            />
          </button>
        </div>
      </section>

      <!--Designs made by fellow Hack Clubbers -->
      <section
        class="min-h-[clamp(20rem,40vw,59.1875rem)] flex flex-col gap-[clamp(1.5rem,4vw,4rem)] p-[clamp(1.5rem,4vw,4rem)] justify-center items-center"
      >
        <div
          class="flex flex-row flex-wrap justify-center items-center gap-[clamp(2.5rem,6vw,5rem)]"
        >
          <Card>
            <div class="flex flex-col w-[clamp(24rem,60vw-24rem,48rem)] gap-8">
              <h2 class="text-4xl font-baloo-2 font-bold">
                See 150+ designs made by fellow Hack Clubbers
              </h2>
              <p class="text-xl font-jakarta-sans leading-relaxed">
                Every design started the same way - an idea, plus the tools and
                support to bring it to life. Learn the basics of CAD by getting
                hands-on. Unsure what to make? Browse designs by the community
                for some inspiration.
              </p>
              <PillOne
                type="arrow"
                label="Browse the gallery"
                modalId="gallery_coming_soon_modal"
                fill="yes"
              />
            </div>
          </Card>
          <img
            src={fusering_cad_model.src}
            alt="Fusering keyring CAD model"
            class="max-w-full h-auto"
          />
        </div>
        <div
          class="grid grid-cols-6 min-[1740px]:grid-cols-5 justify-items-center gap-[clamp(1.5rem,3vw,2.5rem)]"
        >
          <img
            src={project_image_1.src}
            alt="Community keyring design example"
            class="col-span-2 min-[1740px]:col-span-1 max-w-full h-auto"
          />
          <img
            src={project_image_2.src}
            alt="Community keyring design example"
            class="col-span-2 min-[1740px]:col-span-1 max-w-full h-auto"
          />
          <img
            src={project_image_3.src}
            alt="Community keyring design example"
            class="col-span-2 min-[1740px]:col-span-1 max-w-full h-auto"
          />
          <img
            src={project_image_4.src}
            alt="Community keyring design example"
            class="col-span-2 col-start-2 min-[1740px]:col-span-1 min-[1740px]:col-start-auto max-w-full h-auto"
          />
          <img
            src={project_image_5.src}
            alt="Community keyring design example"
            class="col-span-2 col-start-4 min-[1740px]:col-span-1 min-[1740px]:col-start-auto max-w-full h-auto"
          />
        </div>
      </section>
      <section
        class="min-h-[clamp(20rem,40vw,59.1875rem)] flex flex-col gap-[clamp(1.5rem,4vw,4rem)] p-[clamp(1.5rem,4vw,4rem)] justify-center items-center"
      >
        <div class="flex flex-row flex-wrap gap-[clamp(2rem,6vw,4rem)]">
          <div class="flex flex-col gap-8 w-[clamp(24rem,60vw-24rem,48rem)]">
            <div class="flex flex-row gap-4 items-center">
              <img
                src={fusering_logo_colour_small.src}
                alt="Fusering logo"
                class="max-w-full h-auto"
              />
              <h2 class="text-4xl font-baloo-2 font-bold">Submission rules</h2>
            </div>
            <p class="text-xl font-jakarta-sans">
              Before you jump straight into designing, let's go over the rules.
              Please make sure that your submission meets all four requirements
              before you get started! <b
                >You'll also need to upload your design to printables.com to
                submit!</b
              >
            </p>
          </div>
          <img
            src={fusering_projects_cluster.src}
            alt="Cluster of community keyring projects"
            class="self-start max-w-full h-auto"
          />
        </div>
        <div
          class="grid grid-cols-1 min-[640px]:grid-cols-2 min-[1780px]:grid-cols-4 justify-items-center gap-[clamp(1rem,2vw,2rem)]"
        >
          <CardTwo
            icon="eligible"
            title="Eligibility"
            text="You must be <b>aged 13–18, and</b> verified via Hack Club Auth <b>or</b> be taking part in a workshop."
          />
          <CardTwo
            icon="original"
            title="Original work"
            text="No copied artwork or logos, regardless of if they are from a big brand, or not. This means no using AI too."
          />
          <CardTwo
            icon="printable"
            title="Printable size"
            text="Your design must have a flat bottom and fit the max dimensions:"
            dimensions={{ l: "80mm", w: "80mm", d: "6mm" }}
          />
          <CardTwo
            icon="effort"
            title="High effort"
            text="Get creative! A plain rectangle with generic text is likely to be rejected. Projects made in Tinkercad and similar drag and drop CAD tools will be rejected too."
          />
        </div>
      </section>
      <section
        class="min-h-[clamp(20rem,40vw,59.1875rem)] flex flex-col gap-[clamp(1.5rem,4vw,4rem)] p-[clamp(1.5rem,4vw,4rem)] justify-center items-center"
      >
        <div
          class="flex flex-row flex-wrap justify-center min-[1840px]:justify-start gap-[clamp(1.5rem,4vw,4rem)]"
        >
          <img
            src={fusering_sample_cluster.src}
            alt="Sample keyrings in six filament colours"
            class="self-start max-w-full h-auto"
          />
          <div class="flex flex-col gap-16">
            <Card>
              <h2 class="text-4xl font-baloo-2 font-bold">
                Six awesome colour to choose from!
              </h2>
              <p class="text-xl font-jakarta-sans leading-relaxed max-w-3xl">
                Choose from six different filament options, or mix and match
                with multi-colour printing! Most designs are printed in house
                and shipped from Hack Club HQ! Are you a club leader running a
                workshop? We'll bundle all your designs into one package, and
                send them with extra stickers for your members to enjoy!
              </p>
            </Card>
            <img
              src={print_farm_image_cluster.src}
              alt="Hack Club HQ print farm producing keyrings"
              class="self-start max-w-full h-auto"
            />
          </div>
        </div>
      </section>
      <footer>
        <div
          class="flex flex-row flex-wrap w-full justify-between gap-8 bg-text-black text-fusering-beige p-[clamp(1.5rem,4vw,4rem)]"
        >
          <div
            class="grid grid-cols-1 sm:grid-cols-3 w-[min(100%,80rem)] gap-y-8 gap-x-[clamp(1rem,3vw,4rem)]"
          >
            <!--top row -->
            <div class="flex flex-col items-start justify-end">
              <img
                src={fusering_logo_footer.src}
                alt="Fusering logo"
                class="max-w-full h-auto"
              />
            </div>
            <div class="flex flex-col items-start justify-end">
              <h2 class="text-4xl font-baloo-2 font-bold flex flex-row gap-4">
                A <img src={hc_logo_footer.src} alt="Hack Club logo" /> YSWS
              </h2>
            </div>
            <div class="flex flex-col items-start justify-end">
              <h2 class="text-4xl font-baloo-2 font-bold">Resources</h2>
            </div>
            <!-- bottom row -->
            <div>
              <p class="font-jakarta-sans text-xl">
                Fusering V2 is sponsored by David on the YSWS team. Fusering is
                clubs friendly! To apply to run a workshop, please check out the
                clubs portal.
              </p>
            </div>
            <div>
              <p class="font-jakarta-sans text-xl">
                Built for teens, by teens. A 501(C)(3) non profit, EIN:
                81-2908499. Check out our GitHub, Slack, and HCB.
              </p>
            </div>
            <div class="flex flex-col font-jakarta-sans text-xl">
              <a
                href="https://forms.hackclub.com/bounty"
                class="hover:underline">Fulfilment bounty</a
              >
              <a
                href="https://hackclub.com/privacy-and-terms"
                class="hover:underline">Privacy and terms</a
              >
              <a
                href="https://www.figma.com/deck/gX6MAxP5ipzvqXmF9K3tIt/Fusering-Workshop---Onshape-Edition?node-id=1-82&viewport=-132%2C-167%2C0.76&t=CjsVnPT4UcSW3QjO-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1"
                class="hover:underline">Fusering guide</a
              >
              <a href="https://hackclub.com/" class="hover:underline"
                >Hack Club</a
              >
            </div>
          </div>
          <img
            src={cube_cluster_footer.src}
            alt=""
            class="self-start max-w-full h-auto"
          />
        </div>
      </footer>
    </main>

    <dialog id="clubs_info_modal" class="modal">
      <div
        class="modal-box bg-card-beige border-4 border-black/35 rounded-3xl shadow-card"
      >
        <form method="dialog">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-text-black"
          >
            ✕
          </button>
        </form>
        <h3 class="text-4xl font-baloo-2 font-bold">Info for clubs</h3>
        <p class="text-xl font-jakarta-sans leading-relaxed py-4">
          Fusering workshops now have a new home in the clubs portal! To run a
          workshop, ship a project to Fusering, then apply to run a workshop
          through the clubs portal!
        </p>
        <p class="text-xl font-jakarta-sans leading-relaxed py-4">
          We'll 3D print all the designs made by your club members, bundle them
          with carabiners and exclusive Orpheus stickers, and ship them straight
          to your club!
        </p>
        <img
          src={clubs_portal_screenshot.src}
          alt="Hack Club clubs portal workshop application page"
          class="w-full max-w-sm h-auto rounded-xl border-4 border-black/35 my-4 mx-auto"
        />
        <div class="modal-action">
          <PillOne
            type="arrow"
            label="Apply on Clubs Portal"
            path="https://clubs.hackclub.com/workshops"
            fill="yes"
            size="sm"
          />
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <dialog id="guide_info_modal" class="modal">
      <div
        class="modal-box bg-card-beige border-4 border-black/35 rounded-3xl shadow-card"
      >
        <form method="dialog">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-text-black"
          >
            ✕
          </button>
        </form>
        <h3 class="text-4xl font-baloo-2 font-bold">Fusering Guide</h3>
        <p class="text-xl font-jakarta-sans leading-relaxed py-4">
          The new Fusering guide is still under construction and not quite ready
          to be shared yet. In the meantime, here's the old workshop to get you
          started!
        </p>
        <div class="modal-action">
          <PillOne
            type="arrow"
            label="View on Figma Slides"
            path="https://www.figma.com/deck/gX6MAxP5ipzvqXmF9K3tIt/Fusering-Workshop---Onshape-Edition?node-id=1-82&viewport=-132%2C-167%2C0.76&t=CjsVnPT4UcSW3QjO-1&scaling=min-zoom&content-scaling=fixed&page-id=0%3A1"
            fill="yes"
            size="sm"
          />
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <dialog id="gallery_coming_soon_modal" class="modal">
      <div
        class="modal-box bg-card-beige border-4 border-black/35 rounded-3xl shadow-card"
      >
        <form method="dialog">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-text-black"
          >
            ✕
          </button>
        </form>
        <h3 class="text-4xl font-baloo-2 font-bold">Coming soon!</h3>
        <p class="text-xl font-jakarta-sans leading-relaxed py-4">
          The gallery is still under construction. Check back later to see all
          the designs made by fellow Hack Clubbers!
        </p>
        <div class="modal-action">
          <form method="dialog">
            <button
              class="flex flex-row font-baloo-2 rounded-full items-center w-fit shrink-0 p-3 gap-4 bg-fusering-blue border-4 border-black/35 hover:shadow-card"
            >
              <p class="text-xl font-semibold whitespace-nowrap">Got it!</p>
            </button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>

    <dialog id="video_coming_soon_modal" class="modal">
      <div
        class="modal-box bg-card-beige border-4 border-black/35 rounded-3xl shadow-card"
      >
        <form method="dialog">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-4 top-4 text-text-black"
          >
            ✕
          </button>
        </form>
        <h3 class="text-4xl font-baloo-2 font-bold">Coming soon!</h3>
        <p class="text-xl font-jakarta-sans leading-relaxed py-4">
          The fusering tutorial video isn't quite ready yet, we expect to have
          it ready to go by the end of October!
        </p>
        <div class="modal-action">
          <form method="dialog">
            <button
              class="flex flex-row font-baloo-2 rounded-full items-center w-fit shrink-0 p-3 gap-4 bg-fusering-blue border-4 border-black/35 hover:shadow-card"
            >
              <p class="text-xl font-semibold whitespace-nowrap">Got it!</p>
            </button>
          </form>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop">
        <button>close</button>
      </form>
    </dialog>
  </body>
</html>
