---
import "../styles/global.css";

// Components
import PillOne from "../components/pill_one.astro";

// Images
import hero_banner from "../assets/hero_banner.png";
import logo from "../assets/logo.png";
import sticker_arrow_cluster from "../assets/sticker_arrow_cluster.png";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>
  <body class="bg-card-beige text-text-black font-jakarta-sans">
    <!-- Hero banner -->
    <div class="h-fit bg-blue relative">
      <img src={hero_banner.src} class="top-0 left-0 w-full h-auto relative" />
      <div class="absolute z-10 inset-0 top-0 right-0 flex items-center m-16">
        <img src={logo.src} class="" />
      </div>
    </div>

    <!--Main -->
    <main
      class="min-h-screen flex flex-col gap-6 p-16 font-baloo-2 font-bold text-5xl"
    >
      <h1>Design a keyring, we'll ship it to you with stickers!</h1>
      <div class="flex flex-row justify-between h-fit items-center">
        <div class="flex flex-col gap-8">
          <div class="flex flex-row gap-8">
            <PillOne type="guide" label="Read the guide" path="/" />
            <PillOne type="clubs" label="Info for clubs" path="/" />
          </div>
          <div class="flex flex-row row gap-8">
            <PillOne type="submit" label="Submit your design" path="/" />
          </div>
        </div>
        <img src={sticker_arrow_cluster.src} />
      </div>
    </main>
  </body>
</html>
